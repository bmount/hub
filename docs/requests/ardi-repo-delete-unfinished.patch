new file mode 100644
index 0000000..60bb3dd
--- /dev/null
+++ b/crates/ardi-serve/tests/delete_purge.rs
@@ -0,0 +1,227 @@
+//! `repo.delete` and `tenant.purge` over HTTP (natively, or against an
+//! external server with ARDI_TEST_URL).
+#[macro_use]
+mod common;
+
+use common::*;
+use serde_json::{json, Value};
+use std::path::Path;
+
+fn post(url: &str, auth: &str, body: Value) -> (u16, Value) {
+    let mut r = ureq::post(url)
+        .header("Authorization", auth)
+        .config()
+        .http_status_as_error(false)
+        .build()
+        .send_json(&body)
+        .unwrap();
+    let status = r.status().as_u16();
+    (status, r.body_mut().read_json().unwrap_or(json!(null)))
+}
+
+fn call(s: &Server, verb: &str, body: Value) -> (u16, Value) {
+    post(&s.api(&format!("/api/{verb}")), &basic(&s.token), body)
+}
+
+fn call_in(s: &Server, tenant: &str, verb: &str, body: Value) -> (u16, Value) {
+    post(
+        &s.at_root(&format!("/t/{tenant}/api/{verb}")),
+        &basic(&s.token),
+        body,
+    )
+}
+
+fn git_fails(dir: &Path, args: &[&str]) -> String {
+    let out = std::process::Command::new("git")
+        .args(["-c", "protocol.version=2"])
+        .args(args)
+        .current_dir(dir)
+        .env("GIT_CONFIG_NOSYSTEM", "1")
+        .env("HOME", dir)
+        .env("GIT_TERMINAL_PROMPT", "0")
+        .output()
+        .unwrap();
+    assert!(!out.status.success(), "expected git {args:?} to fail");
+    String::from_utf8_lossy(&out.stderr).into_owned()
+}
+
+fn class(v: &Value) -> &str {
+    v["error"]["class"].as_str().unwrap_or("")
+}
+
+#[test]
+fn delete_refuses_wrong_confirm_and_non_admins() {
+    let s = Server::start();
+    s.create("keep");
+    for body in [
+        json!({"name": "keep", "confirm": "kep"}),
+        json!({"name": "keep", "confirm": "keep.git"}),
+        json!({"name": "keep", "confirm": "KEEP"}),
+    ] {
+        let (st, v) = call(&s, "repo.delete", body.clone());
+        assert_eq!((st, class(&v)), (400, "usage"), "{body} {v}");
+    }
+    let (st, v) = call(&s, "repo.delete", json!({"name": "keep"}));
+    assert_eq!((st, class(&v)), (400, "usage"), "missing confirm: {v}");
+
+    let (st, v) = call(
+        &s,
+        "principal.create",
+        json!({"id": "member", "kind": "agent", "role": "member"}),
+    );
+    assert_eq!(st, 200, "{v}");
+    let (st, v) = call(&s, "token.create", json!({"principal": "member"}));
+    assert_eq!(st, 200, "{v}");
+    let secret = v["result"]["secret"].as_str().unwrap().to_string();
+    let (st, v) = post(
+        &s.api("/api/repo.delete"),
+        &basic_as("member", &secret),
+        json!({"name": "keep", "confirm": "keep"}),
+    );
+    assert_eq!((st, class(&v)), (403, "auth"), "{v}");
+    let (st, v) = post(
+        &s.api("/api/tenant.purge"),
+        &basic_as("member", &secret),
+        json!({"tenant": s.tenant, "confirm": s.tenant}),
+    );
+    assert_eq!((st, class(&v)), (403, "auth"), "{v}");
+
+    let (_, v) = call(&s, "repo.list", json!({}));
+    assert_eq!(v["result"]["repos"], json!(["keep"]), "nothing deleted");
+    let (st, v) = call(&s, "repo.info", json!({"repo": "keep"}));
+    assert_eq!(st, 200, "{v}");
+}
+
+#[test]
+fn delete_wipes_the_repo_and_a_recreate_starts_empty() {
+    let s = Server::start();
+    s.create("gone");
+    s.create("other");
+    let src = fixture_repo();
+    git(src.path(), &["push", "-q", &s.url("gone"), "main"]);
+    git(src.path(), &["push", "-q", &s.url("other"), "main"]);
+    let (_, v) = call(&s, "repo.info", json!({"repo": "gone"}));
+    assert!(v["result"]["commits"].as_u64().unwrap() > 0, "{v}");
+
+    let (st, v) = call(
+        &s,
+        "repo.delete",
+        json!({"name": "gone", "confirm": "gone"}),
+    );
+    assert_eq!(st, 200, "{v}");
+    assert_eq!(
+        v,
+        json!({"ok": true, "result": {"name": "gone", "deleted": true}})
+    );
+    if let Some(root) = s.root() {
+        assert!(!root.join(&s.tenant).join("gone.git").exists());
+    }
+
+    let (_, v) = call(&s, "repo.list", json!({}));
+    assert_eq!(v["result"]["repos"], json!(["other"]));
+    let (st, v) = call(&s, "repo.info", json!({"repo": "gone"}));
+    assert_eq!((st, class(&v)), (404, "not_found"), "{v}");
+    let err = git_fails(src.path(), &["ls-remote", &s.url("gone")]);
+    assert!(
+        err.contains("404") || err.contains("not found"),
+        "stderr: {err}"
+    );
+    // A second delete finds nothing.
+    let (st, v) = call(
+        &s,
+        "repo.delete",
+        json!({"name": "gone", "confirm": "gone"}),
+    );
+    assert_eq!((st, class(&v)), (404, "not_found"), "{v}");
+
+    // The name is free; the new repository has nothing of the old one.
+    s.create("gone");
+    let (_, v) = call(&s, "repo.info", json!({"repo": "gone"}));
+    assert_eq!(v["result"]["commits"], json!(0), "{v}");
+    assert_eq!(v["result"]["refs"], json!(0), "{v}");
+    assert_eq!(v["result"]["objects"], json!(0), "{v}");
+    let ls = git_str(src.path(), &["ls-remote", &s.url("gone")]);
+    assert!(ls.trim().is_empty(), "ls-remote: {ls}");
+    // The other repository is untouched.
+    let (_, v) = call(&s, "repo.info", json!({"repo": "other"}));
+    assert!(v["result"]["commits"].as_u64().unwrap() > 0, "{v}");
+    // `.git` names work when confirmed as given.
+    let (st, v) = call(
+        &s,
+        "repo.delete",
+        json!({"name": "gone.git", "confirm": "gone.git"}),
+    );
+    assert_eq!(st, 200, "{v}");
+    assert_eq!(v["result"]["name"], json!("gone"));
+}
+
+#[test]
+fn purge_deletes_every_repo_and_the_tenant() {
+    let s = Server::start();
+    let t = s.fresh_tenant("purged");
+    for name in ["a", "b"] {
+        let (st, v) = call_in(&s, &t, "repo.create", json!({ "name": name }));
+        assert_eq!(st, 200, "{v}");
+    }
+    let src = fixture_repo();
+    git(
+        src.path(),
+        &["push", "-q", &s.url_in(&t, "ardi", &s.token, "a"), "main"],
+    );
+    let (st, v) = call_in(
+        &s,
+        &t,
+        "principal.create",
+        json!({"id": "bot", "kind": "agent", "role": "member"}),
+    );
+    assert_eq!(st, 200, "{v}");
+
+    for body in [
+        json!({"tenant": t, "confirm": "nope"}),
+        json!({"tenant": "elsewhere", "confirm": "elsewhere"}),
+        json!({"tenant": t}),
+    ] {
+        let (st, v) = call_in(&s, &t, "tenant.purge", body.clone());
+        assert_eq!((st, class(&v)), (400, "usage"), "{body} {v}");
+    }
+    let (_, v) = call_in(&s, &t, "repo.list", json!({}));
+    assert_eq!(v["result"]["repos"], json!(["a", "b"]), "nothing purged");
+
+    let (st, v) = call_in(&s, &t, "tenant.purge", json!({"tenant": t, "confirm": t}));
+    assert_eq!(st, 200, "{v}");
+    assert_eq!(
+        v,
+        json!({"ok": true, "result": {"tenant": t, "purged": true, "repos": ["a", "b"]}})
+    );
+    if let Some(root) = s.root() {
+        assert!(!root.join(&t).exists(), "tenant directory removed");
+    }
+    // The bootstrap token makes the tenant afresh: no repositories, no
+    // principals but admin.
+    let (_, v) = call_in(&s, &t, "repo.list", json!({}));
+    assert_eq!(v["result"]["repos"], json!([]), "{v}");
+    let (_, v) = call_in(&s, &t, "principal.list", json!({}));
+    let ids: Vec<&str> = v["result"]["principals"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|p| p["id"].as_str().unwrap())
+        .collect();
+    assert!(!ids.contains(&"bot"), "principals: {ids:?}");
+    let err = git_fails(
+        src.path(),
+        &["ls-remote", &s.url_in(&t, "ardi", &s.token, "a")],
+    );
+    assert!(
+        err.contains("404") || err.contains("not found"),
+        "stderr: {err}"
+    );
+    // A purged repository name starts empty.
+    let (st, _) = call_in(&s, &t, "repo.create", json!({"name": "a"}));
+    assert_eq!(st, 200);
+    let (_, v) = call_in(&s, &t, "repo.info", json!({"repo": "a"}));
+    assert_eq!(v["result"]["commits"], json!(0), "{v}");
+    // The default tenant is untouched.
+    let (st, _) = call(&s, "repo.list", json!({}));
+    assert_eq!(st, 200);
+}
