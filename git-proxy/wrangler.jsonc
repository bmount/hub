{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "pimwell-git",
  "main": "index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "version_metadata": { "binding": "WORKER_VERSION" },
  "analytics_engine_datasets": [{ "binding": "PERF", "dataset": "pimwell_perf" }],
  "observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "enabled": true, "invocation_logs": false, "persist": false } },
  "tail_consumers": [{ "service": "pimwell-tail" }],
  "vars": { "HUB_DOMAIN": "pimwell.com", "GIT_BACKEND": "artifacts", "ARTIFACTS_ACCOUNT_ID": "f48d61ea6cf57096b3f7bcb02fa0c3e5" },
  "services": [{ "binding": "HUB", "service": "pimwell-hub" }],
  "d1_databases": [{ "binding": "HUB_DB", "database_name": "pimwell-hub", "database_id": "c4f3cf5f-ddae-47ed-bffc-5db014a34f6e", "migrations_dir": "../migrations" }],
  "kv_namespaces": [{ "binding": "RATE", "id": "bb594176ceb94d83ac5a74ff160ac53c" }],
  "r2_buckets": [{ "binding": "GIT_PUSH_STAGING", "bucket_name": "pimwell-git-staging" }],
  "triggers": { "crons": ["17 * * * *"] },
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }]
}
