+/// Deletes a registered repository: `confirm` must equal `name` exactly.
+/// The shell wipes the storage first (`delete_repo`), then the name is
+/// unregistered, so a delete interrupted between the two leaves the name
+/// registered and a retry finishes it; once unregistered, the name is free
+/// and a later `repo.create` starts empty. An unregistered name is 404.
+pub fn repo_delete<S: Sql, B: Blobs>(
+    ctx: &mut Ctx<'_, S, B>,
+    args: &Args,
+) -> Result<Outcome, ApiError> {
+    let name = arg_str(args, "name")?;
+    let base = base_name(name);
+    if !valid_name(base) || reserved_repo_name(base) {
+        return Err(usage(format!("invalid name for repository {name}")));
+    }
+    if arg_str(args, "confirm")? != name {
+        return Err(usage(format!(
+            "confirm must equal the repository name ({name}) exactly"
+        )));
+    }
+    if !tenant_store(&mut ctx.tenant)?.repo_exists(base)? {
+        return Err(not_found(format!("repository {name} not found")));
+    }
+    let delete = ctx
+        .delete_repo
+        .ok_or_else(|| server("repo.delete is not available here"))?;
+    delete(base)?;
+    tenant_store(&mut ctx.tenant)?.unregister_repo(base)?;
+    Ok(Outcome::new(json!({ "name": base, "deleted": true })))
+}
+
+/// Deletes every registered repository (each as `repo.delete`: wiped, then
