{
  "name": "pimwell-hub",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "npm run test:dependencies && vitest run",
    "test:dependencies": "node --test scripts/test-dev-dependencies.mjs",
    "test:watch": "vitest",
    "sync:upstream": "node scripts/sync-upstream.ts",
    "docs:mcp": "vitest run test/mcp-reference.test.ts --update",
    "test:browser:chat": "node scripts/test-chat-browser.mjs",
    "typecheck": "tsc --noEmit",
    "migrate:local": "wrangler d1 migrations apply HUB_DB --local",
    "migrate:remote": "scripts/cf/with-deploy-token.sh wrangler d1 migrations apply HUB_DB --remote",
    "deploy": "scripts/cf/with-deploy-token.sh wrangler deploy",
    "deploy:tail": "scripts/cf/with-deploy-token.sh wrangler deploy -c tail/wrangler.jsonc",
    "cf": "scripts/cf/with-deploy-token.sh wrangler"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.2",
    "@modelcontextprotocol/server": "2.3.1",
    "hono": "^4.6.0",
    "mailauth": "7.1.1",
    "postal-mime": "^4.0.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261001.1",
    "@playwright/test": "1.64.0",
    "@types/node": "^26.6.4",
    "@vitest/runner": "~4.1.0",
    "@vitest/snapshot": "~4.1.0",
    "miniflare": "5.20260815.0-alpha",
    "typescript": "^5.6.0",
    "vitest": "~4.1.0",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261006.1": true
  },
  "overrides": {
    "miniflare": {
      "workerd": "1.20261006.1",
      "sharp": "0.35.5",
      "undici": "7.29.1"
    }
  }
}
