+    /// Wipes a repository's directory (not its registration: `repo.delete`
+    /// unregisters it through the tenant store it holds locked). Forgets
+    /// the open store first, waiting for the request holding it. A missing
+    /// directory is success, so an interrupted delete can be retried.
+    /// Blocking: file I/O.
+    pub fn delete_repo_dir(&self, tenant: &str, name: &str) -> Result<(), StatusCode> {
+        let name = name.strip_suffix(".git").unwrap_or(name);
+        let dir = self.repo_dir(tenant, name)?;
+        let open = lock_recover(&self.repos).remove(&format!("{tenant}/{name}"));
+        if let Some(r) = open {
+            drop(lock_recover(&r));
+        }
+        remove_dir_if_present(&dir)
+    }
+
+    /// Removes a tenant's directory (its store and anything left in it) and
+    /// forgets its open stores, so the name is as if never used. The
+    /// caller must hold no lock on the tenant's store. Blocking: file I/O.
+    pub fn purge_tenant_dir(&self, tenant: &str) -> Result<(), StatusCode> {
+        if !valid_name(tenant) {
+            return Err(StatusCode::BAD_REQUEST);
+        }
+        let mut tenants = lock_recover(&self.tenants);
+        if let Some(t) = tenants.remove(tenant) {
+            drop(lock_recover(&t));
+        }
+        let prefix = format!("{tenant}/");
+        lock_recover(&self.repos).retain(|k, _| !k.starts_with(&prefix));
+        remove_dir_if_present(&self.root.join(tenant))
+    }
