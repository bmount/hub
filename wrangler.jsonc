{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pimwell-hub",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "version_metadata": { "binding": "WORKER_VERSION" },
  "analytics_engine_datasets": [{ "binding": "PERF", "dataset": "pimwell_perf" }],
  // Workers Logs: every console line is stored and searchable (docs/ops/logging.md). Cloudflare's own invocation
  // entries are off: they record full URLs, which can carry invite and sign-in tokens. Our request line is redacted.
  "observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "enabled": true, "invocation_logs": false, "persist": false } },
  "tail_consumers": [{ "service": "pimwell-tail" }],
  "routes": [
    { "pattern": "pimwell.com", "custom_domain": true },
    { "pattern": "*.pimwell.com/*", "zone_name": "pimwell.com" }
  ],
  "vars": {
    "HUB_DOMAIN": "pimwell.com",
    "GIT_BACKEND": "artifacts",
    "ARTIFACTS_ACCOUNT_ID": "f48d61ea6cf57096b3f7bcb02fa0c3e5",
    "ARDI_REPO_CREATE": "on"
  },
  "services": [{ "binding": "GIT_PROXY", "service": "pimwell-git" }],
  "r2_buckets": [{ "binding": "GIT_PUSH_STAGING", "bucket_name": "pimwell-git-staging" }],
  // Push sync from the git host every five minutes (src/code/sync.ts).
  "triggers": { "crons": ["*/5 * * * *"] },
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "d1_databases": [
    {
      "binding": "HUB_DB",
      "database_name": "pimwell-hub",
      "database_id": "c4f3cf5f-ddae-47ed-bffc-5db014a34f6e",
      "migrations_dir": "migrations"
    }
  ],
  // Outbound mail: sign-in links from login@, and replies and agent mail from org, project and agent addresses
  // (src/verbs/mailOut.ts decides the From address; nobody passes one in).
  "send_email": [{ "name": "MAIL" }],
  "kv_namespaces": [
    { "binding": "RATE", "id": "bb594176ceb94d83ac5a74ff160ac53c" },
    { "binding": "OAUTH_KV", "id": "f4d9750c9bdd4cbc839b8efc7d17ab3c" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "CONVERSATION", "class_name": "Conversation" },
      { "name": "INBOX", "class_name": "Inbox" }
    ]
  },
  "migrations": [{ "tag": "chat-v1", "new_sqlite_classes": ["Conversation", "Inbox"] }]
}
