{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // The tail consumer for apps in this account (docs/superpowers/specs/2026-10-07-app-telemetry-and-agent-mail-design.md).
  // Deploy: npm run deploy:tail. No routes and no workers.dev URL: it can only be reached as a tail consumer.
  "name": "pimwell-tail",
  "main": "index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "version_metadata": { "binding": "WORKER_VERSION" },
  "analytics_engine_datasets": [{ "binding": "PERF", "dataset": "pimwell_perf" }],
  "services": [{ "binding": "HUB", "service": "pimwell-hub", "entrypoint": "Ingest" }],
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false, "persist": false } }
}
