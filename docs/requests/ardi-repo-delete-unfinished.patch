+/// tenant object), so the name is as if never used.
+pub fn tenant_purge<S: Sql, B: Blobs>(
+    ctx: &mut Ctx<'_, S, B>,
+    args: &Args,
+) -> Result<Outcome, ApiError> {
+    let tenant = arg_str(args, "tenant")?;
+    if tenant != ctx.tenant_name {
+        return Err(usage(format!(
+            "tenant must name this tenant ({})",
+            ctx.tenant_name
+        )));
+    }
+    if arg_str(args, "confirm")? != tenant {
+        return Err(usage(format!(
+            "confirm must equal the tenant name ({tenant}) exactly"
+        )));
+    }
+    let delete = ctx
+        .delete_repo
+        .ok_or_else(|| server("tenant.purge is not available here"))?;
+    let repos = tenant_store(&mut ctx.tenant)?.repos()?;
+    for name in &repos {
+        delete(name)?;
+        tenant_store(&mut ctx.tenant)?.unregister_repo(name)?;
+    }
+    Ok(Outcome::new(
+        json!({ "tenant": tenant, "purged": true, "repos": repos }),
